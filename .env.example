# promohub environment (JODA: ~/stack/promohub/.env, chmod 600)
DATABASE_URL=postgres://promohub:CHANGE_ME@promohub-db:5432/promohub?sslmode=disable
PROMOHUB_DB_PASSWORD=CHANGE_ME  # also used by compose for promohub-db (put it in the stack .env too)

APIFY_TOKEN=
# random, >= 24 chars; goes into the Apify webhook URL as ?secret=
APIFY_WEBHOOK_SECRET=
# IFTTT → Webhooks → Documentation → "Your key is: …"
IFTTT_KEY=
# random, >= 24 chars; IFTTT applets call /webhooks/ifttt/<event>?secret=
IFTTT_INBOUND_SECRET=

# Optional direct sinks (rules.yaml → sinks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_MILESTONES=

LOG_LEVEL=info

# --- Account secrets (Prompts/01-ACCOUNTS_PLAN.md, wave 1). Prefix = auth_ref in accounts.yaml.
# Bluesky: Settings → Privacy and security → App passwords
BLUESKY_MAIN_APP_PASSWORD=
# Mastodon: Preferences → Development → New application (read, write:statuses, write:media)
MASTODON_MAIN_TOKEN=
# Google Cloud: API key restricted to YouTube Data API v3 (shared by all channels)
YOUTUBE_API_KEY=
# The Telegram channel collector uses TELEGRAM_BOT_TOKEN above (bot must be a channel admin).
