# promohub environment (JODA: ~/stack/promohub/.env, chmod 600)
DATABASE_URL=postgres://promohub:CHANGE_ME@promohub-db:5432/promohub?sslmode=disable
PROMOHUB_DB_PASSWORD=CHANGE_ME  # also used by compose for promohub-db (put it in the stack .env too)

APIFY_TOKEN=
# random, >= 24 chars; goes into the Apify webhook URL as ?secret=
APIFY_WEBHOOK_SECRET=
# IFTTT → Webhooks → Documentation → "Your key is: …"
IFTTT_KEY=
# random, >= 24 chars; IFTTT applets call /webhooks/ifttt/<event>?secret=
IFTTT_INBOUND_SECRET=

# Optional direct sinks (rules.yaml → sinks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_MILESTONES=

LOG_LEVEL=info

# --- Account secrets (Prompts/01-ACCOUNTS_PLAN.md, wave 1). Prefix = auth_ref in accounts.yaml.
# Bluesky: Settings → Privacy and security → App passwords
BLUESKY_MAIN_APP_PASSWORD=
# Mastodon: Preferences → Development → New application (read, write:statuses, write:media)
MASTODON_MAIN_TOKEN=
# Google Cloud: API key restricted to YouTube Data API v3 (shared by all channels)
YOUTUBE_API_KEY=
# The Telegram channel collector uses TELEGRAM_BOT_TOKEN above (bot must be a channel admin).

# --- Publishing (wave 2). The approval bot needs its OWN bot token above: getUpdates long
# polling conflicts with any other process using the same bot.
# Telegram user IDs allowed to approve (comma-separated; the first one gets proposals).
TELEGRAM_ADMIN_IDS=
# Public base URL of the hub (media links for IFTTT/Instagram/Threads, OAuth redirects).
PUBLIC_BASE_URL=https://promo.ol1n.com
# Discord announcement channel webhook (accounts.yaml auth_ref: DISCORD_ANNOUNCE).
DISCORD_ANNOUNCE_WEBHOOK=
# Optional LLM composer (OpenAI-compatible gateway); without it texts are only trimmed.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- OAuth accounts (wave 3+). Tokens are stored encrypted in Postgres with this key.
# openssl rand -hex 32 — losing it means /connect again for every OAuth account.
PROMOHUB_SECRET_KEY=
# Meta apps (Prompts/02-CHROME_PROMPTS.md prompt 4). Redirect URIs: <PUBLIC_BASE_URL>/oauth/<platform>/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Google OAuth client for YouTube Analytics (wave 4), TikTok Login Kit (wave 4)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Long tail (wave 5)
PRODUCTHUNT_TOKEN=
DEVTO_MAIN_API_KEY=
